# File: .env.example
# Purpose: Template variables for the local Docker CI/CD demo stack
# Save to: docker-cicd-demo/.env.example

# General
COMPOSE_PROJECT_NAME=docker-cicd-demo
TZ=Europe/Budapest
VM_IP=192.168.56.10

# Domains
GITEA_DOMAIN=gitea.local
JENKINS_DOMAIN=jenkins.local
REGISTRY_DOMAIN=registry.local
PORTAINER_DOMAIN=portainer.local
NPM_DOMAIN=npm.local

# Image versions
GITEA_VERSION=1.24
REGISTRY_VERSION=2
NPM_VERSION=latest
PORTAINER_VERSION=lts

# Gitea
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222
GITEA_ROOT_URL=http://${GITEA_DOMAIN}
GITEA_SSH_DOMAIN=${GITEA_DOMAIN}
GITEA_RUN_MODE=prod
GITEA_APP_NAME=Docker CI/CD Demo Gitea

# Jenkins
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000

# Docker Registry
REGISTRY_HTTP_PORT=5001
REGISTRY_AUTH=htpasswd
REGISTRY_AUTH_REALM=Registry Realm
REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd

# Nginx Proxy Manager
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443
NPM_INITIAL_ADMIN_EMAIL=admin@example.local
NPM_INITIAL_ADMIN_PASSWORD=change-me

# Portainer
PORTAINER_EDGE_PORT=8000
PORTAINER_HTTPS_PORT=9443